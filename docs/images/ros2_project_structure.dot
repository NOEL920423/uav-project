digraph G {
 graph [bgcolor="#f8fafc", pad="0.5", nodesep="0.32", ranksep="0.7", fontname="DejaVu Sans", fontsize=23, fontcolor="#0f172a", labelloc=t, labeljust=l];
 node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", penwidth=1.5, fontname="DejaVu Sans", fontsize=15, margin="0.20,0.13", fontcolor="#0f172a"];
 edge [color="#64748b", penwidth=1.5, arrowsize=0.7, fontname="DejaVu Sans", fontsize=12, fontcolor="#475569"];
rankdir=LR;
label="ROS 2 | Project structure tree
Current source layout · selected files and modules\nPython packages: package.xml, setup.py, setup.cfg, resource/, README.md, test/";
root [label="uav-project/", fillcolor="#0f172a", fontcolor="white", color="#0f172a"];
src [label="ros2_ws/src/", fillcolor="#e0f2fe", color="#38bdf8"];
root -> src;
interfaces [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3aed"><B>uav_interfaces/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">msg/      12 custom message definitions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">srv/       6 service definitions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">action/    RunEpisode.action</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">CMakeLists.txt, package.xml</FONT></TD></TR></TABLE>>];
src -> interfaces [arrowhead=none];
bringup [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"><B>uav_bringup/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">launch/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  uav_system_scaffold.launch.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_bringup/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  __init__.py</FONT></TD></TR></TABLE>>];
src -> bringup [arrowhead=none];
scene [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#0284c7"><B>uav_scene_bridge/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_scene_bridge/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  scene_bridge_node.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  runtime_contract.py</FONT></TD></TR></TABLE>>];
src -> scene [arrowhead=none];
camera [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b"><B>uav_camera_bridge/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_camera_bridge/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  camera_bridge_node.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  [idle placeholder]</FONT></TD></TR></TABLE>>];
src -> camera [arrowhead=none];
navigation [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#059669"><B>uav_navigation/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_navigation/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  planner/     A*, B-spline, geometry</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  trajectory/  timing, sampling, yaw</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  tracking/    follower, tracker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  diagnostics/ offline tools</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">launch/, config/, test/</FONT></TD></TR></TABLE>>];
src -> navigation [arrowhead=none];
control [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#d97706"><B>uav_px4_control/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_px4_control/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  control/     mux, joystick, sources</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  px4/         odometry, gate, streamer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  flight/      supervisors, BC, command owner</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  diagnostics/ monitors, offline tools</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">launch/, config/, test/</FONT></TD></TR></TABLE>>];
src -> control [arrowhead=none];
recorder [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#e11d48"><B>uav_data_recorder/</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">uav_data_recorder/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  expert_dataset_recorder_node.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  expert_dataset_contract.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  episode_scene_client.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">  data_recorder_node.py [placeholder]</FONT></TD></TR></TABLE>>];
src -> recorder [arrowhead=none];
external [label="Related modules outside the ROS workspace\lisaac/runtime/   Simulation + ROS sensor publication\luav_ml/          Dataset, training, BC inference\l", fillcolor="#f1f5f9"];
root -> external [style=dashed, arrowhead=none];
{rank=same; src; external;}
}
