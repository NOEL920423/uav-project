<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>Harmless Phase 1 launch scaffold for the UAV ROS 2 packages.</description>
  <maintainer email="a0916190423@gmail.com">Noel</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>uav_scene_bridge</exec_depend>
  <exec_depend>uav_camera_bridge</exec_depend>
  <exec_depend>uav_navigation</exec_depend>
  <exec_depend>uav_px4_control</exec_depend>
  <exec_depend>uav_data_recorder</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
