#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
ROS_WS="$REPO_ROOT/ros2_ws"
ROS_SETUP="/opt/ros/jazzy/setup.bash"
WORKSPACE_SETUP="$ROS_WS/install/setup.bash"
RUN_LOG_DIR="$REPO_ROOT/run_logs"
SCRIPT_PATH="$REPO_ROOT/uav"
ISAAC_SIM_RELEASE="${UAV_ISAAC_SIM_RELEASE:-$HOME/isaacsim/_build/linux-x86_64/release}"

readonly SCRIPT_DIR REPO_ROOT ROS_WS ROS_SETUP WORKSPACE_SETUP
readonly RUN_LOG_DIR SCRIPT_PATH
readonly ISAAC_SIM_RELEASE

info() {
    printf 'INFO: %s\n' "$*"
}

warn() {
    printf 'WARN: %s\n' "$*" >&2
}

error() {
    printf 'ERROR: %s\n' "$*" >&2
}

die() {
    error "$*"
    return 1
}

usage() {
    cat <<'EOF'
用法：./uav <command> [arguments]

Expert collection, AE/ResNet training, BC training, and PX4 flight evaluation.

指令：
  help           顯示此說明
  backup         備份研究資料至 NAS（需互動確認）
  status         不修改檔案，顯示 Git 與 workspace 狀態
  doctor         檢查 ROS、Python、workspace、環境與 topic 安全性
  build          在隔離的 Jazzy 環境建置 ROS 2 workspace
  test           測試已建置的 workspace
  verify         執行 doctor、build、測試、介面／import／靜態檢查
  ae-train        訓練以 episode 分割的 FPV/TOP/depth Autoencoder baseline
  resnet-train    使用指定資料集與專家動作訓練 64 維 ResNet18 encoder
  bc-train        訓練並離線評估正式的 BC baseline
  bc-eval         使用 Isaac/Pegasus/PX4 飛行 TOP RGB BC policy
  eval            bc-eval 的別名；使用 --scene v3|v4 選擇測試場景
  bc-eval-plot    由正式 BC evaluation artifact 重新產生圖表
  ml-test         執行不依賴 ROS/Isaac 的 ML regression tests
  px4-sitl-doctor     唯讀檢查已執行的 SITL/XRCE graph
  px4-sitl-flight-check  在執行中的 SITL 飛行一個受保護的 ASTAR_EXPERT 任務
  isaac-runtime-flight-check  要求受保護任務具備 Isaac evidence
  expert-collect  收集可續跑的 canonical cylinder expert dataset
  expert-collect-publish  收集、驗證、上傳 NAS，成功後刪除本機 dataset
  expert-runtime-smoke  在單一持續 Isaac runtime 中重啟 PX4 episodes
  expert-scene-preview  透過 WebRTC 預覽一個正式 expert scene
  expert-validate  驗證正式 cylinder expert dataset
  artifact-publish SHA-256 驗證後將完成的本地 artifact 複製至 NAS
  profile <name> <workflow> [arguments]
                 執行維護中的 workflow preset，並附加額外 arguments
  topics         檢查目前 ROS graph 並拒絕 /fmu/in/ topics
  interfaces     顯示自訂 interfaces 與 planner topic contracts
  shell          開啟乾淨的互動式 ROS 2 workspace shell

範例：
  ./uav verify
  ./uav ae-train --dataset bc_expert_cube --epochs 200
  ./uav bc-train --dataset bc_expert_cube --epochs 500
  ./uav eval --scene v3 --checkpoint /path/to/best.pt --episodes 1 --visible
  ./uav bc-eval-plot evaluations/bc/run_TIMESTAMP
  ./uav ml-test
  ./uav px4-sitl-doctor
  UAV_OFFLINE_TIMEOUT_SECONDS=150 ./uav px4-sitl-flight-check
  UAV_OFFLINE_TIMEOUT_SECONDS=180 ./uav isaac-runtime-flight-check
  ./uav expert-collect --scene v3 --episodes 100 --dataset cylinder_v3_new
  ./uav expert-runtime-smoke --episodes 2
  ./uav expert-collect --episodes 100 --dataset bc_expert_cube --max-attempts 150 --resume
  ./uav expert-collect-publish --episodes 100 --max-attempts 150 --dataset cylinder_v3 --nas-root /home/noel_614420090/NAS
  ./uav expert-scene-preview --seed 103001
  ./uav expert-validate --episodes 100
  ./uav artifact-publish evaluations/bc/run_TIMESTAMP --nas-root "$UAV_NAS_ROOT" --category evaluations/bc --delete-local
  ./uav profile current expert-collect --episodes 10
  ./uav shell
EOF
}

run_profile() {
    local profile_name="$1"
    local workflow="$2"
    shift 2
    local profile_path="$REPO_ROOT/config/profiles/${profile_name}.json"
    local profile_output
    local -a profile_arguments

    [[ "$profile_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid profile name: $profile_name"
    [[ -f "$profile_path" ]] || die "profile is missing: $profile_path"
    if ! profile_output="$(python3 - "$profile_path" "$workflow" <<'PY'
import json
import sys

path, workflow = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    profile = json.load(handle)
arguments = profile.get("workflows", {}).get(workflow)
if not isinstance(arguments, list) or not all(isinstance(item, str) for item in arguments):
    raise SystemExit(f"profile does not define workflow: {workflow}")
print(*arguments, sep="\n")
PY
    )"; then
        return 1
    fi
    mapfile -t profile_arguments <<< "$profile_output"
    "$SCRIPT_PATH" "$workflow" "${profile_arguments[@]}" "$@"
}

require_repository() {
    if [[ ! -d "$REPO_ROOT/.git" ]]; then
        die "repository check failed: $REPO_ROOT/.git is missing"
        return 1
    fi
    if [[ ! -d "$ROS_WS/src" ]]; then
        die "repository check failed: $ROS_WS/src is missing"
        return 1
    fi
    if [[ ! -f "$REPO_ROOT/uav" ]]; then
        die "repository check failed: root-level uav command is missing"
        return 1
    fi
}

require_ros_base() {
    [[ -f "$ROS_SETUP" ]] || die "required ROS setup is missing: $ROS_SETUP"
    [[ -x /usr/bin/python3 ]] || die "required Python is missing: /usr/bin/python3"
}

require_workspace_overlay() {
    if [[ ! -f "$WORKSPACE_SETUP" ]]; then
        die "workspace overlay is missing: $WORKSPACE_SETUP; run ./uav build first"
        return 1
    fi
}

clean_environment_command() {
    local internal_command="$1"
    shift

    local home_value="${HOME:-}"
    local user_value="${USER:-}"
    local timeout_value="${UAV_OFFLINE_TIMEOUT_SECONDS:-20}"
    local -a clean_variables

    [[ -n "$home_value" ]] || die "HOME must be set"
    if [[ -z "$user_value" ]]; then
        user_value="$(/usr/bin/id -un)"
    fi

    clean_variables=(
        "HOME=$home_value"
        "USER=$user_value"
        "PATH=/usr/bin:/bin"
        "LANG=C.UTF-8"
        "UAV_OFFLINE_TIMEOUT_SECONDS=$timeout_value"
        "UAV_WRAPPER_CLEAN_ENV=1"
    )
    if [[ -n "${TERM:-}" ]]; then
        clean_variables+=("TERM=$TERM")
    fi
    local persistent_variable
    for persistent_variable in \
        UAV_TIMING_DIR \
        UAV_TIMING_SCHED_SECONDS \
        UAV_BC_FLIGHT_DIAGNOSTICS \
        UAV_EXPERT_SCENE_PREPARED \
        UAV_EXPERT_RUNTIME_GENERATION \
        UAV_EXPERT_SCENE_REVISION \
        UAV_EXPERT_MIN_FPV_FRAME \
        UAV_EXPERT_MIN_OBSERVER_FRAME \
        UAV_EXPERT_MIN_DEPTH_FRAME
    do
        if [[ -n "${!persistent_variable:-}" ]]; then
            clean_variables+=(
                "$persistent_variable=${!persistent_variable}"
            )
        fi
    done

    env -i "${clean_variables[@]}" \
        /usr/bin/bash "$SCRIPT_PATH" __clean "$internal_command" "$@"
}

print_clean_summary() {
    local overlay_state="$1"
    printf 'Python path: %s\n' "$(command -v python3)"
    printf 'Python version: %s\n' "$(python3 --version 2>&1)"
    printf 'ROS distribution: %s\n' "${ROS_DISTRO:-<unset>}"
    printf 'Workspace: %s\n' "$ROS_WS"
    printf 'Workspace overlay sourced: %s\n' "$overlay_state"
}

source_setup_file() {
    local setup_file="$1"
    set +u
    # ROS 產生的 setup 腳本會合理地檢查可能未設定的變數。
    # shellcheck disable=SC1090,SC1091
    source "$setup_file"
    set -u
}

clean_bootstrap() {
    local overlay_policy="$1"

    require_repository
    require_ros_base
    source_setup_file "$ROS_SETUP"

    if [[ "$(command -v python3)" != "/usr/bin/python3" ]]; then
        die "clean environment selected unexpected Python: $(command -v python3)"
        return 1
    fi
    if [[ "${ROS_DISTRO:-}" != "jazzy" ]]; then
        die "expected ROS_DISTRO=jazzy, got ${ROS_DISTRO:-<unset>}"
        return 1
    fi
    if [[ "${AMENT_PREFIX_PATH:-}" == *"uav_ros2_ws"* ]]; then
        die "legacy workspace contamination detected in AMENT_PREFIX_PATH"
        return 1
    fi

    case "$overlay_policy" in
        required)
            require_workspace_overlay
            source_setup_file "$WORKSPACE_SETUP"
            print_clean_summary "yes"
            ;;
        optional)
            if [[ -f "$WORKSPACE_SETUP" ]]; then
                source_setup_file "$WORKSPACE_SETUP"
                print_clean_summary "yes"
            else
                print_clean_summary "no (not built yet)"
            fi
            ;;
        none)
            print_clean_summary "no"
            ;;
        *)
            die "internal error: unknown overlay policy $overlay_policy"
            return 1
            ;;
    esac
}

scan_forbidden_topics() {
    local topics
    if ! topics="$(ros2 topic list)"; then
        die "unable to inspect ROS topics"
        return 1
    fi
    local forbidden
    forbidden="$(printf '%s\n' "$topics" | /usr/bin/grep -E '^/fmu/in(/|$)' || true)"
    if [[ -n "$forbidden" ]]; then
        error "unexpected /fmu/in/* topics detected"
        printf '%s\n' "$forbidden" >&2
        return 1
    fi
    printf 'SAFE: no /fmu/in/* topics detected\n'
}

show_interfaces() {
    local interface_name
    for interface_name in \
        uav_interfaces/msg/Obstacle \
        uav_interfaces/msg/ObstacleArray \
        uav_interfaces/msg/EpisodeState \
        uav_interfaces/msg/TrajectoryPoint \
        uav_interfaces/msg/TimedTrajectory \
        uav_interfaces/msg/TrajectoryTrackingStatus \
        uav_interfaces/msg/ControlMuxStatus \
        uav_interfaces/msg/Px4OutputGateStatus \
        uav_interfaces/msg/Px4SetpointCandidate \
        uav_interfaces/msg/Px4StreamStatus \
        uav_interfaces/msg/Px4FlightStatus \
        uav_interfaces/msg/Px4SyntheticTelemetry \
        uav_interfaces/srv/GenerateEpisode \
        uav_interfaces/srv/SetControlSource \
        uav_interfaces/srv/SetPx4OutputEnable \
        uav_interfaces/srv/SetPx4StreamEnable \
        uav_interfaces/srv/SetPx4FlightEnable \
        uav_interfaces/srv/SendPx4VehicleCommand
    do
        printf '\nInterface: %s\n' "$interface_name"
        ros2 interface show "$interface_name"
    done
}

run_colcon_build() {
    local -a build_arguments=("$@")
    cd "$ROS_WS"
    set +e
    colcon build --symlink-install "${build_arguments[@]}"
    local build_status=$?
    set -e
    if ((build_status != 0)); then
        return "$build_status"
    fi
    [[ -f "$WORKSPACE_SETUP" ]] || die "build succeeded but overlay is missing"
}

run_colcon_tests() {
    local -a test_arguments=("$@")
    cd "$ROS_WS"
    set +e
    colcon test "${test_arguments[@]}"
    local test_status=$?
    colcon test-result --verbose
    local result_status=$?
    set -e
    if ((test_status != 0)); then
        return "$test_status"
    fi
    return "$result_status"
}

check_pure_navigation_imports() {
    local module_root="$ROS_WS/src/uav_navigation/uav_navigation"
    local -a pure_modules=(
        "$module_root/planner/coordinate_frames.py"
        "$module_root/planner/geometry.py"
        "$module_root/planner/models.py"
        "$module_root/planner/astar_planner.py"
        "$module_root/planner/bspline_smoother.py"
        "$module_root/planner/path_simplifier.py"
        "$module_root/planner/path_validator.py"
        "$module_root/planner/path_metrics.py"
        "$module_root/trajectory/trajectory_models.py"
        "$module_root/trajectory/trajectory_parameterizer.py"
        "$module_root/trajectory/trajectory_validator.py"
        "$module_root/trajectory/yaw_profile.py"
        "$module_root/trajectory/trajectory_metrics.py"
        "$module_root/trajectory/trajectory_sampler.py"
        "$module_root/tracking/tracking_models.py"
        "$module_root/tracking/trajectory_tracker.py"
        "$module_root/tracking/tracking_validator.py"
    )
    local pattern
    pattern='^[[:space:]]*(from|import)[[:space:]]+(rclpy|omni|isaac|px4_msgs|pymavlink|pegasus|viewport)|/fmu/in/'
    local findings
    findings="$(/usr/bin/grep -inE "$pattern" "${pure_modules[@]}" || true)"
    if [[ -n "$findings" ]]; then
        error "forbidden runtime import found in pure navigation modules"
        printf '%s\n' "$findings" >&2
        return 1
    fi
    printf 'SAFE: pure navigation modules contain no forbidden runtime imports\n'
}

check_pure_control_imports() {
    local module_root="$ROS_WS/src/uav_px4_control/uav_px4_control"
    local -a pure_modules=(
        "$module_root/control/control_source_models.py"
        "$module_root/control/control_source_registry.py"
