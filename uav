internal_px4_check() {
    local command_name="$1"
    shift
    clean_bootstrap required
    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-20}"
    if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
        die "UAV_OFFLINE_TIMEOUT_SECONDS must be a positive integer"
        return 1
    fi
    local launch_file
    case "$command_name" in
        px4-map-check)
            python3 -m pytest -q \
                "$ROS_WS/src/uav_px4_control/test/test_px4_timestamp.py" \
                "$ROS_WS/src/uav_px4_control/test/test_px4_setpoint_mapping.py"
            launch_file="px4_mapping_offline.launch.py"
            ;;
        px4-gate-check)
            python3 -m pytest -q \
                "$ROS_WS/src/uav_px4_control/test/test_px4_output_gate.py"
            launch_file="px4_gate_offline.launch.py"
            ;;
        px4-boundary-check)
            launch_file="px4_boundary_offline.launch.py"
            ;;
        *)
            die "internal error: unknown Phase 7 check $command_name"
            return 1
            ;;
    esac
    cd "$REPO_ROOT"
    set +e
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control "$launch_file" "$@"
    local launch_status=$?
    set -e
    scan_forbidden_topics
    return "$launch_status"
}

