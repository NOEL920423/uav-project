run_colcon_build() {
    local -a build_arguments=("$@")
    cd "$ROS_WS"
    set +e
    colcon build --symlink-install "${build_arguments[@]}"
    local build_status=$?
    set -e
    if ((build_status != 0)); then
        return "$build_status"
    fi
    [[ -f "$WORKSPACE_SETUP" ]] || die "build succeeded but overlay is missing"
}

run_colcon_tests() {
    local -a test_arguments=("$@")
    cd "$ROS_WS"
    set +e
    colcon test "${test_arguments[@]}"
    local test_status=$?
    colcon test-result --verbose
    local result_status=$?
    set -e
    if ((test_status != 0)); then
        return "$test_status"
    fi
    return "$result_status"
}

check_pure_navigation_imports() {
    local module_root="$ROS_WS/src/uav_navigation/uav_navigation"
    local -a pure_modules=(
        "$module_root/coordinate_frames.py"
        "$module_root/geometry.py"
        "$module_root/geometric_comparison.py"
        "$module_root/models.py"
        "$module_root/astar_planner.py"
        "$module_root/bspline_smoother.py"
        "$module_root/path_simplifier.py"
        "$module_root/path_validator.py"
        "$module_root/path_metrics.py"
        "$module_root/trajectory_models.py"
        "$module_root/trajectory_parameterizer.py"
        "$module_root/trajectory_validator.py"
        "$module_root/yaw_profile.py"
        "$module_root/trajectory_metrics.py"
        "$module_root/tracking_models.py"
        "$module_root/trajectory_sampler.py"
        "$module_root/trajectory_tracker.py"
        "$module_root/tracking_validator.py"
        "$module_root/tracking_metrics.py"
        "$module_root/offline_kinematic_plant.py"
        "$module_root/tracking_fixtures.py"
        "$module_root/tracking_comparison.py"
    )
    local pattern
    pattern='^[[:space:]]*(from|import)[[:space:]]+(rclpy|omni|isaac|px4_msgs|pymavlink|pegasus|viewport)|/fmu/in/'
    local findings
    findings="$(/usr/bin/grep -inE "$pattern" "${pure_modules[@]}" || true)"
    if [[ -n "$findings" ]]; then
        error "forbidden runtime import found in pure navigation modules"
        printf '%s\n' "$findings" >&2
        return 1
    fi
    printf 'SAFE: pure navigation modules contain no forbidden runtime imports\n'
}

