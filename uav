internal_px4_sitl_stream_check() {
    clean_bootstrap required
    require_px4_msgs
    ros2 run uav_px4_control px4_sitl_doctor
    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-20}"
    if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
        die "UAV_OFFLINE_TIMEOUT_SECONDS must be a positive integer"
        return 1
    fi
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control px4_sitl_stream.launch.py "$@"
}

internal_px4_sitl_flight_check() {
    clean_bootstrap required
    require_px4_msgs
    ros2 run uav_px4_control px4_sitl_doctor
    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-150}"
    if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
        die "UAV_OFFLINE_TIMEOUT_SECONDS must be a positive integer"
        return 1
    fi
    if ((timeout_seconds <= 10)); then
        die "PX4 SITL flight timeout must exceed 10 seconds"
        return 1
    fi
    local timestamp evidence_path
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    evidence_path="$RUN_LOG_DIR/px4-sitl-flight_${timestamp}.json"
    mkdir -p "$RUN_LOG_DIR"
    warn "AUTHORIZED SITL FLIGHT: OFFBOARD, arm, takeoff, track, and land"
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control px4_sitl_flight.launch.py \
        evidence_path:="$evidence_path" \
        timeout_s:="$((timeout_seconds - 10)).0" "$@"
    [[ -f "$evidence_path" ]] || die "flight evidence was not written"
    python3 - "$evidence_path" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
payload = json.loads(path.read_text(encoding="utf-8"))
print(f"Flight evidence: {path}")
print(f"Flight success: {payload.get('success')}")
if not payload.get("success"):
    raise SystemExit(1)
PY
}

