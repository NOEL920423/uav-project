command_status() {
    printf 'Repository: %s\n' "$REPO_ROOT"
    git -c core.pager=cat -C "$REPO_ROOT" status
    git -C "$REPO_ROOT" branch --show-current
    git -c core.pager=cat -C "$REPO_ROOT" log -5 --oneline
    git -C "$REPO_ROOT" remote -v
    git -c core.pager=cat -C "$REPO_ROOT" branch -vv

    local directory
    for directory in src build install log; do
        if [[ -d "$ROS_WS/$directory" ]]; then
            printf 'EXISTS: ros2_ws/%s\n' "$directory"
        else
            printf 'MISSING: ros2_ws/%s\n' "$directory"
        fi
    done
}

check_inherited_environment() {
    if [[ "${AMENT_PREFIX_PATH:-}" == *"uav_ros2_ws"* ]]; then
        warn "inherited AMENT_PREFIX_PATH contains the legacy workspace"
    else
        printf 'Inherited AMENT_PREFIX_PATH: no legacy workspace detected\n'
    fi
    if [[ -n "${VIRTUAL_ENV:-}" ]]; then
        warn "VIRTUAL_ENV is active outside the wrapper: $VIRTUAL_ENV"
    else
        printf 'Inherited VIRTUAL_ENV: inactive\n'
    fi
    if [[ -n "${PYENV_VERSION:-}" ]]; then
        warn "PYENV_VERSION is active outside the wrapper: $PYENV_VERSION"
    else
        printf 'Inherited PYENV_VERSION: inactive\n'
    fi

    local path_before_system="${PATH%%/usr/bin*}"
    if [[ "$path_before_system" == *".pyenv/shims"* ]]; then
        warn "pyenv shims occur before /usr/bin; clean commands will discard them"
    else
        printf 'Inherited PATH: no pyenv shim before /usr/bin\n'
    fi
}

command_doctor() {
    check_inherited_environment
    clean_environment_command doctor
}

command_verify() {
    mkdir -p "$RUN_LOG_DIR"
    local timestamp
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    local log_file="$RUN_LOG_DIR/verify_${timestamp}.log"
    info "verification log: $log_file"

    set +e
    (
        command_doctor && clean_environment_command verify
    ) 2>&1 | tee "$log_file"
    local verify_status=${PIPESTATUS[0]}
    set -e
    return "$verify_status"
}

command_offline_check() {
    mkdir -p "$RUN_LOG_DIR"
    local timestamp
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    local log_file="$RUN_LOG_DIR/offline_check_${timestamp}.log"
    info "offline-check log: $log_file"

    set +e
    clean_environment_command offline-check "$@" 2>&1 | tee "$log_file"
    local launch_status=${PIPESTATUS[0]}
    set -e

    if ((launch_status != 0 && launch_status != 124)); then
        error "offline launch failed with exit code $launch_status"
        return "$launch_status"
    fi
    if ! /usr/bin/grep -q 'offline integration passed:' "$log_file"; then
        die "offline success marker was not found in $log_file"
        return 1
    fi
    if ! /usr/bin/grep -Eq \
        'raw=[1-9][0-9]*, simplified=[1-9][0-9]*, final=[1-9][0-9]*, frame=px4_ned' \
        "$log_file"
    then
        die "offline path counts or px4_ned frame marker are missing"
        return 1
    fi
    if ! /usr/bin/grep -q 'Planner status: SUCCESS|' "$log_file"; then
        die "planner SUCCESS status marker was not found"
        return 1
    fi
    if ! /usr/bin/grep -q 'SAFE: no /fmu/in/\* topics detected' "$log_file"; then
        die "offline /fmu/in/* safety marker was not found"
        return 1
    fi
    if ((launch_status == 124)); then
        warn "timeout stopped a validated persistent launch; accepting exit 124"
    fi
    printf 'OFFLINE CHECK SUCCESS: raw, simplified, final, frame, and status validated\n'
}

command_phase4_check() {
    local check_name="$1"
    local success_marker="$2"
    shift 2
    mkdir -p "$RUN_LOG_DIR"
    local timestamp log_file launch_status
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    log_file="$RUN_LOG_DIR/${check_name}_${timestamp}.log"
    info "$check_name log: $log_file"
    set +e
    clean_environment_command "$check_name" "$@" 2>&1 | tee "$log_file"
    launch_status=${PIPESTATUS[0]}
    set -e
    if ((launch_status != 0)); then
        error "$check_name failed with exit code $launch_status"
        return "$launch_status"
    fi
    if ! /usr/bin/grep -q "$success_marker" "$log_file"; then
        die "$check_name success marker was not found in $log_file"
        return 1
    fi
    if ! /usr/bin/grep -q 'SAFE: no /fmu/in/\* topics detected' "$log_file"; then
        die "$check_name safety marker was not found in $log_file"
        return 1
    fi
    printf '%s SUCCESS: finite non-flight fixture validated\n' \
        "${check_name^^}"
}

