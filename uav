            if (($# != 0)); then
                die "phase10b-expert-pilot takes no arguments"
                return 64
            fi
            local dataset_root base_seed episode_number episode_id seed mode
            local expected evidence runtime_root pilot_timestamp
            local agent_pid isaac_pid runtime_status episode_status
            dataset_root="$REPO_ROOT/artifacts/datasets/bc_expert_v1_phase10b"
            base_seed="${UAV_PHASE10B_BASE_SEED:-101000}"
            [[ "$base_seed" =~ ^[0-9]+$ ]] || die \
                "UAV_PHASE10B_BASE_SEED must be a nonnegative integer"
            if [[ -e "$dataset_root" ]]; then
                die "refusing to overwrite $dataset_root"
                return 1
            fi
            [[ -x "$ISAAC_SIM_RELEASE/isaac-sim.streaming.sh" ]] \
                || die "Isaac streaming launcher missing: $ISAAC_SIM_RELEASE"
            command -v MicroXRCEAgent >/dev/null \
                || die "MicroXRCEAgent is not available"
