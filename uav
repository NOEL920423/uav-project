#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
ROS_WS="$REPO_ROOT/ros2_ws"
ROS_SETUP="/opt/ros/jazzy/setup.bash"
WORKSPACE_SETUP="$ROS_WS/install/setup.bash"
RUN_LOG_DIR="$REPO_ROOT/run_logs"
SCRIPT_PATH="$REPO_ROOT/uav"

readonly SCRIPT_DIR REPO_ROOT ROS_WS ROS_SETUP WORKSPACE_SETUP
readonly RUN_LOG_DIR SCRIPT_PATH

info() {
    printf 'INFO: %s\n' "$*"
}

warn() {
    printf 'WARN: %s\n' "$*" >&2
}

error() {
    printf 'ERROR: %s\n' "$*" >&2
}

die() {
    error "$*"
    return 1
}

usage() {
    cat <<'EOF'
用法：./uav <command> [arguments]

資料收集、模型訓練與 Isaac/Pegasus/PX4 閉環測試。

指令：
  help             顯示此說明
  build            在隔離的 Jazzy 環境建置 ROS 2 workspace
  expert-collect   收集可續跑的 expert dataset
  expert-validate  驗證 expert dataset
  ae-train         訓練 Autoencoder
  resnet-train     訓練 ResNet18 encoder
  bc-train         訓練 BC 並執行離線評估
  bc-eval          執行 BC policy 閉環飛行測試
  eval             bc-eval 的別名
  bc-eval-plot     使用既有閉環測試結果重新產生圖表
  profile <name> <workflow> [arguments]
                   使用既有 workflow preset，並附加額外 arguments

範例：
  ./uav build
  ./uav expert-collect --scene v4 --episodes 100 --dataset cylinder_v4_new
  ./uav expert-collect --scene v4 --episodes 100 --dataset cylinder_v4_new --resume
  ./uav expert-validate --dataset cylinder_v4_new
  ./uav ae-train --dataset cylinder_v4_new --epochs 200
  ./uav resnet-train --dataset cylinder_v4_new --epochs 200
  ./uav bc-train --dataset cylinder_v4_new --epochs 500
  ./uav eval --scene v4 --checkpoint /path/to/best.pt --episodes 1 --visible
  ./uav bc-eval-plot evaluations/bc/run_TIMESTAMP
  ./uav profile current expert-collect --episodes 10

各工作流程的完整參數：./uav <command> --help
EOF
}

run_profile() {
    local profile_name="$1"
    local workflow="$2"
    shift 2
    local profile_path="$REPO_ROOT/config/profiles/${profile_name}.json"
    local profile_output
    local -a profile_arguments

    [[ "$profile_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid profile name: $profile_name"
    [[ -f "$profile_path" ]] || die "profile is missing: $profile_path"
    if ! profile_output="$(python3 - "$profile_path" "$workflow" <<'PY'
import json
import sys

path, workflow = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    profile = json.load(handle)
arguments = profile.get("workflows", {}).get(workflow)
if not isinstance(arguments, list) or not all(isinstance(item, str) for item in arguments):
    raise SystemExit(f"profile does not define workflow: {workflow}")
print(*arguments, sep="\n")
PY
    )"; then
        return 1
    fi
    mapfile -t profile_arguments <<< "$profile_output"
    "$SCRIPT_PATH" "$workflow" "${profile_arguments[@]}" "$@"
}

require_repository() {
    if [[ ! -d "$REPO_ROOT/.git" ]]; then
        die "repository check failed: $REPO_ROOT/.git is missing"
        return 1
    fi
    if [[ ! -d "$ROS_WS/src" ]]; then
        die "repository check failed: $ROS_WS/src is missing"
        return 1
    fi
    if [[ ! -f "$REPO_ROOT/uav" ]]; then
        die "repository check failed: root-level uav command is missing"
        return 1
    fi
}

require_ros_base() {
    [[ -f "$ROS_SETUP" ]] || die "required ROS setup is missing: $ROS_SETUP"
    [[ -x /usr/bin/python3 ]] || die "required Python is missing: /usr/bin/python3"
}

require_workspace_overlay() {
    if [[ ! -f "$WORKSPACE_SETUP" ]]; then
        die "workspace overlay is missing: $WORKSPACE_SETUP; run ./uav build first"
        return 1
    fi
}

clean_environment_command() {
    local internal_command="$1"
    shift

    local home_value="${HOME:-}"
    local user_value="${USER:-}"
    local timeout_value="${UAV_OFFLINE_TIMEOUT_SECONDS:-20}"
    local -a clean_variables

    [[ -n "$home_value" ]] || die "HOME must be set"
    if [[ -z "$user_value" ]]; then
        user_value="$(/usr/bin/id -un)"
    fi

    clean_variables=(
        "HOME=$home_value"
        "USER=$user_value"
        "PATH=/usr/bin:/bin"
        "LANG=C.UTF-8"
        "UAV_OFFLINE_TIMEOUT_SECONDS=$timeout_value"
        "UAV_WRAPPER_CLEAN_ENV=1"
    )
    if [[ -n "${TERM:-}" ]]; then
        clean_variables+=("TERM=$TERM")
    fi
    local persistent_variable
    for persistent_variable in \
        ROS_LOG_DIR \
        UAV_NAS_ROOT \
        UAV_TIMING_DIR \
        UAV_TIMING_SCHED_SECONDS \
        UAV_BC_FLIGHT_DIAGNOSTICS \
        UAV_EXPERT_SCENE_PREPARED \
        UAV_EXPERT_RUNTIME_GENERATION \
        UAV_EXPERT_SCENE_REVISION \
        UAV_EXPERT_MIN_FPV_FRAME \
        UAV_EXPERT_MIN_OBSERVER_FRAME \
        UAV_EXPERT_MIN_DEPTH_FRAME
    do
        if [[ -n "${!persistent_variable:-}" ]]; then
            clean_variables+=(
                "$persistent_variable=${!persistent_variable}"
            )
        fi
    done

    env -i "${clean_variables[@]}" \
        /usr/bin/bash "$SCRIPT_PATH" __clean "$internal_command" "$@"
}

print_clean_summary() {
    local overlay_state="$1"
    printf 'Python path: %s\n' "$(command -v python3)"
    printf 'Python version: %s\n' "$(python3 --version 2>&1)"
    printf 'ROS distribution: %s\n' "${ROS_DISTRO:-<unset>}"
    printf 'Workspace: %s\n' "$ROS_WS"
    printf 'Workspace overlay sourced: %s\n' "$overlay_state"
}

source_setup_file() {
    local setup_file="$1"
    set +u
    # ROS setup scripts may check variables that are not set.
    # shellcheck disable=SC1090,SC1091
    source "$setup_file"
    set -u
}

clean_bootstrap() {
    local overlay_policy="$1"

    require_repository
    require_ros_base
    source_setup_file "$ROS_SETUP"

    if [[ "$(command -v python3)" != "/usr/bin/python3" ]]; then
        die "clean environment selected unexpected Python: $(command -v python3)"
        return 1
    fi
    if [[ "${ROS_DISTRO:-}" != "jazzy" ]]; then
        die "expected ROS_DISTRO=jazzy, got ${ROS_DISTRO:-<unset>}"
        return 1
    fi
    if [[ "${AMENT_PREFIX_PATH:-}" == *"uav_ros2_ws"* ]]; then
        die "legacy workspace contamination detected in AMENT_PREFIX_PATH"
        return 1
    fi

    case "$overlay_policy" in
        required)
            require_workspace_overlay
            source_setup_file "$WORKSPACE_SETUP"
            print_clean_summary "yes"
            ;;
        none)
            print_clean_summary "no"
            ;;
        *)
            die "internal error: unknown overlay policy $overlay_policy"
            return 1
            ;;
    esac
}

run_colcon_build() {
    local -a build_arguments=("$@")
    cd "$ROS_WS"
    set +e
    colcon build --symlink-install "${build_arguments[@]}"
    local build_status=$?
    set -e
    if ((build_status != 0)); then
        return "$build_status"
    fi
    [[ -f "$WORKSPACE_SETUP" ]] || die "build succeeded but overlay is missing"
}

require_px4_msgs() {
    if ! ros2 pkg prefix px4_msgs >/dev/null 2>&1; then
        die "px4_msgs is absent from this workspace overlay; run: ./uav build --base-paths src /home/noel_614420090/uav_ros2_ws/src/px4_msgs"
        return 1
    fi
}

internal_expert_wait_runtime() {
    clean_bootstrap required
    require_px4_msgs
    local deadline status echo_status
    deadline=$((SECONDS + 120))
    while ((SECONDS < deadline)); do
        set +e
        status="$(timeout 5s ros2 topic echo \
            /uav/isaac/runtime_status std_msgs/msg/String \
            --once --field data 2>/dev/null)"
        echo_status=$?
        set -e
        if ((echo_status == 0)) \
            && [[ "$status" == *'"fpv_rgb_ready":true'* ]] \
            && [[ "$status" == *'"observer_rgb_ready":true'* ]] \
            && [[ "$status" == *'"fpv_depth_ready":true'* ]]; then
            if ros2 run uav_px4_control px4_sitl_doctor; then
                info "Expert collection Isaac/PX4 runtime ready"
                return 0
            fi
        fi
        sleep 2
    done
    die "expert collection runtime did not become ready within 120 seconds"
}

internal_expert_prepare_scene() {
    local episode_id="$1"
    local random_seed="$2"
    local scene_version="${3:-v4}"
    local scene_profile_path="${4:-}"
    local evidence_path="${5:-}"
    clean_bootstrap required
    require_px4_msgs
    local -a scene_arguments=()
    if [[ -n "$scene_profile_path" ]]; then
        scene_arguments+=(-p "scene_profile_path:=$scene_profile_path")
    fi
    if [[ -n "$evidence_path" ]]; then
        scene_arguments+=(-p "evidence_path:=$evidence_path")
    fi
    ros2 run uav_data_recorder episode_scene_client --ros-args \
        -p episode_id:="$episode_id" \
        -p random_seed:="$random_seed" \
        -p scene_mode:=normal \
        -p scene_version:="$scene_version" \
        -p timeout_s:=20.0 "${scene_arguments[@]}"
}

internal_expert_run_episode() {
    local episode_id="$1"
    local random_seed="$2"
    local dataset_root="$3"
    clean_bootstrap required
    require_px4_msgs
    local sensor_status sensor_status_code
    set +e
    sensor_status="$(timeout 15s ros2 topic echo \
        /uav/isaac/runtime_status std_msgs/msg/String \
        --once --field data 2>/dev/null)"
    sensor_status_code=$?
    set -e
    if ((sensor_status_code != 0)) \
        || [[ "$sensor_status" != *'"fpv_rgb_ready":true'* ]] \
        || [[ "$sensor_status" != *'"observer_rgb_ready":true'* ]] \
        || [[ "$sensor_status" != *'"fpv_depth_ready":true'* ]]; then
        die "expert collection sensor runtime is not ready"
        return 1
    fi

    if [[ "${UAV_EXPERT_SCENE_PREPARED:-0}" != "1" ]]; then
        ros2 run uav_data_recorder episode_scene_client --ros-args \
            -p episode_id:="$episode_id" \
            -p random_seed:="$random_seed" \
            -p scene_mode:=normal \
            -p timeout_s:=20.0
    fi

    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-180}"
    local timestamp evidence_path episode_evidence launch_status
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    evidence_path="$RUN_LOG_DIR/expert-${episode_id}_${timestamp}.json"
    mkdir -p "$RUN_LOG_DIR"
    warn "AUTHORIZED EXPERT SITL FLIGHT episode=$episode_id seed=$random_seed"
    set +e
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control px4_sitl_flight.launch.py \
        evidence_path:="$evidence_path" \
        timeout_s:="$((timeout_seconds - 10)).0" \
        use_external_scene:=true \
        require_isaac_evidence:=true \
        record_expert_dataset:=true \
        dataset_root:="$dataset_root" \
        episode_id:="$episode_id" \
        collection_mode:=batch \
        random_seed:="$random_seed" \
        expected_runtime_generation:="${UAV_EXPERT_RUNTIME_GENERATION:--1}" \
        expected_scene_revision:="${UAV_EXPERT_SCENE_REVISION:-0}" \
        minimum_fpv_frame_count:="${UAV_EXPERT_MIN_FPV_FRAME:-0}" \
        minimum_observer_frame_count:="${UAV_EXPERT_MIN_OBSERVER_FRAME:-0}" \
        minimum_depth_frame_count:="${UAV_EXPERT_MIN_DEPTH_FRAME:-0}" \
        start_delay_s:=5.0
    launch_status=$?
    set -e
    [[ -f "$evidence_path" ]] || die \
        "episode flight evidence missing (launch status $launch_status)"
    [[ -d "$dataset_root/$episode_id" ]] || die \
        "episode recorder output missing: $dataset_root/$episode_id"
    episode_evidence="$dataset_root/$episode_id/flight_evidence.json"
    cp -- "$evidence_path" "$episode_evidence"
    info "Expert episode launch status=$launch_status evidence=$episode_evidence"
}

internal_bc_flight_run() {
    local result_path="$1"
    local episode="$2"
    local random_seed="$3"
    local image_source="$4"
    local checkpoint_path="$5"
    local ml_python="$6"
    local device="$7"
    local image_sources="${8:-$image_source}"
    local video_spool_dir=""
    if [[ "${UAV_BC_FLIGHT_DIAGNOSTICS:-1}" == "1" ]]; then
        video_spool_dir="$(dirname -- "$result_path")/policy_input_frames"
    fi
    clean_bootstrap required
    require_px4_msgs
    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-180}"
    warn "AUTHORIZED BC SITL FLIGHT episode=$episode seed=$random_seed"
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control bc_flight.launch.py \
        repository_root:="$REPO_ROOT" \
        result_path:="$result_path" \
        episode:="$episode" \
        seed:="$random_seed" \
        image_source:="$image_source" \
        image_sources:="$image_sources" \
        video_spool_dir:="$video_spool_dir" \
        checkpoint_path:="$checkpoint_path" \
        ml_python:="$ml_python" \
        device:="$device"
}

internal_isaac_trace_replay() {
    local trace_path="$1"
    local playback_speed="$2"
    clean_bootstrap required
    [[ -f "$trace_path" ]] || die "trace file is missing: $trace_path"
    local payload timeout_seconds deadline status
    payload="$(/usr/bin/python3 - "$trace_path" "$playback_speed" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1]).resolve()
speed = float(sys.argv[2])
if speed <= 0.0:
    raise ValueError("playback speed must be positive")
print(json.dumps({"data": json.dumps({
    "command": "replay_trace",
    "trace_path": str(path),
    "playback_speed": speed,
})}))
PY
)" || return 1
    ros2 topic pub --once /uav/isaac/episode_command std_msgs/msg/String \
        "$payload"
    timeout_seconds="$(/usr/bin/python3 - "$trace_path" "$playback_speed" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    samples = json.load(source)["samples"]
duration = float(samples[-1]["time_s"]) / float(sys.argv[2])
print(max(10, int(duration) + 10))
PY
)" || return 1
    deadline=$((SECONDS + timeout_seconds))
    while ((SECONDS < deadline)); do
        status="$(timeout 2s ros2 topic echo /uav/isaac/runtime_status \
            std_msgs/msg/String --once --field data 2>/dev/null || true)"
        if [[ "$status" == *'"state":"completed"'* ]]; then
            return 0
        fi
        if [[ "$status" == *'"episode_command_error"'* ]] \
            && [[ "$status" != *'"episode_command_error":""'* ]]; then
            die "Isaac trace replay failed: $status"
            return 1
        fi
    done
    die "Isaac trace replay timed out after ${timeout_seconds}s"
    return 1
}

internal_dispatch() {
    local command_name="${1:-}"
    shift || true
    case "$command_name" in
        build)
            clean_bootstrap none
            run_colcon_build "$@"
            ;;
        expert-runtime-wait)
            internal_expert_wait_runtime
            ;;
        expert-scene-prepare)
            internal_expert_prepare_scene "$@"
            ;;
        expert-run-episode)
            internal_expert_run_episode "$@"
            ;;
        bc-flight-run)
            internal_bc_flight_run "$@"
            ;;
        isaac-trace-replay)
            internal_isaac_trace_replay "$@"
            ;;
        *)
            die "internal error: unsupported clean command: $command_name"
            ;;
    esac
}

main() {
    local command_name="${1:-help}"
    if [[ "$command_name" == "__clean" ]]; then
        if [[ "${UAV_WRAPPER_CLEAN_ENV:-}" != "1" ]]; then
            die "internal clean commands must be entered through a public subcommand"
            return 1
        fi
        shift
        internal_dispatch "$@"
        return
    fi

    case "$command_name" in
        help|-h|--help)
            usage
            ;;
        profile)
            require_repository
            shift
            [[ $# -ge 2 ]] || die "usage: ./uav profile <name> <workflow> [arguments]"
            run_profile "$@"
            ;;
        ae-train)
            require_repository
            shift
            python3 -m uav_ml.train_autoencoder "$@"
            ;;
        bc-train)
            require_repository
            shift
            python3 -m uav_ml.tools.bc_baseline "$@"
            ;;
        resnet-train)
            require_repository
            shift
            python3 -m uav_ml.tools.bc_baseline "$@" --encoder-type resnet18_trainable
            ;;
        bc-eval|eval)
            require_repository
            shift
            python3 -m uav_ml.tools.bc_flight_evaluation "$@"
            ;;
        bc-eval-plot)
            require_repository
            shift
            python3 -m uav_ml.tools.bc_flight_plotting "$@"
            ;;
        expert-collect)
            require_repository
            shift
            python3 -m uav_ml.tools.expert_collect "$@"
            ;;
        expert-validate)
            require_repository
            shift
            python3 -m uav_ml.tools.validate_expert_collection "$@"
            ;;
        expert-runtime-wait|expert-scene-prepare|expert-run-episode|bc-flight-run|isaac-trace-replay)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            clean_environment_command "$command_name" "$@"
            ;;
        build)
            require_repository
            require_ros_base
            shift
            clean_environment_command build "$@"
            ;;
        *)
            error "unknown command: $command_name"
            usage >&2
            return 64
            ;;
    esac
}

main "$@"
