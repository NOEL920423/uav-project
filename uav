            require_ros_base
            require_workspace_overlay
            shift
            command_phase4_check \
                px4-boundary-check \
                'px4 boundary offline integration passed:' "$@"
            ;;
        topics)
            require_repository
            require_ros_base
            require_workspace_overlay
            clean_environment_command topics
            ;;
        interfaces)
            require_repository
            require_ros_base
            require_workspace_overlay
            clean_environment_command interfaces
            print_planner_topics
            ;;
        shell)
            require_repository
            require_ros_base
            clean_environment_command shell
            ;;
        *)
            error "unknown command: $command_name"
            usage >&2
            return 64
            ;;
    esac
}

main "$@"
