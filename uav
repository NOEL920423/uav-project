}

check_generated_files_untracked() {
    local pattern
    pattern='(^|/)(build|install|log|run_logs|__pycache__|\.pytest_cache)(/|$)|\.(bag|db3|pt|onnx)$'
    local tracked
    tracked="$(git -C "$REPO_ROOT" ls-files | /usr/bin/grep -E "$pattern" || true)"
    if [[ -n "$tracked" ]]; then
        error "generated or runtime files are tracked by Git"
        printf '%s\n' "$tracked" >&2
        return 1
    fi
    printf 'SAFE: generated files and runtime logs are not tracked\n'
}

internal_doctor() {
    clean_bootstrap optional
    command -v ros2 >/dev/null || die "ros2 command is unavailable"
    command -v colcon >/dev/null || die "colcon command is unavailable"

    printf 'Repository: %s\n' "$REPO_ROOT"
    printf 'Package count: %s\n' "$(
        find "$ROS_WS/src" -mindepth 2 -maxdepth 2 -name package.xml | wc -l
    )"
    if [[ -f "$WORKSPACE_SETUP" ]]; then
        printf 'Install overlay: available\n'
    else
        warn "install overlay is absent; run ./uav build before test"
    fi
    printf 'Git branch: %s\n' "$(git -C "$REPO_ROOT" branch --show-current)"
    if [[ -n "$(git -C "$REPO_ROOT" status --porcelain=v1)" ]]; then
        warn "working tree has local changes"
    else
        printf 'Working tree: clean\n'
    fi
    scan_forbidden_topics
}

internal_verify() {
    clean_bootstrap none
    run_colcon_build
    source_setup_file "$WORKSPACE_SETUP"
    printf 'Workspace overlay sourced after build: yes\n'
    run_colcon_tests

    local package_name
    for package_name in \
        uav_interfaces \
        uav_scene_bridge \
        uav_navigation \
        uav_px4_control \
        uav_data_recorder
    do
        ros2 pkg prefix "$package_name"
    done

    show_interfaces

    python3 -c "import uav_scene_bridge"
    python3 -c "import uav_navigation"
    python3 -c "import uav_px4_control"
    python3 -c "import uav_data_recorder"

    check_pure_navigation_imports
    check_pure_control_imports
    scan_forbidden_topics
    check_generated_files_untracked
    printf 'VERIFY SUCCESS: build, tests, interfaces, imports, and safety checks passed\n'
}

require_px4_msgs() {
    if ! ros2 pkg prefix px4_msgs >/dev/null 2>&1; then
        die "px4_msgs is absent from this workspace overlay; run: ./uav build --base-paths src /home/noel_614420090/uav_ros2_ws/src/px4_msgs"
        return 1
    fi
}

internal_px4_sitl_doctor() {
    clean_bootstrap required
    require_px4_msgs
    ros2 run uav_px4_control px4_sitl_doctor
}

internal_px4_sitl_flight_check() {
    clean_bootstrap required
    require_px4_msgs
    ros2 run uav_px4_control px4_sitl_doctor
    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-150}"
    if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
        die "UAV_OFFLINE_TIMEOUT_SECONDS must be a positive integer"
        return 1
    fi
    if ((timeout_seconds <= 10)); then
        die "PX4 SITL flight timeout must exceed 10 seconds"
        return 1
    fi
    local timestamp evidence_path
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    evidence_path="$RUN_LOG_DIR/px4-sitl-flight_${timestamp}.json"
    mkdir -p "$RUN_LOG_DIR"
    warn "AUTHORIZED SITL FLIGHT: OFFBOARD, arm, takeoff, track, and land"
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control px4_sitl_flight.launch.py \
        evidence_path:="$evidence_path" \
        timeout_s:="$((timeout_seconds - 10)).0" "$@"
    [[ -f "$evidence_path" ]] || die "flight evidence was not written"
    python3 - "$evidence_path" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
payload = json.loads(path.read_text(encoding="utf-8"))
print(f"Flight evidence: {path}")
print(f"Flight success: {payload.get('success')}")
if not payload.get("success"):
    raise SystemExit(1)
PY
}

internal_isaac_runtime_flight_check() {
    internal_px4_sitl_flight_check \
        use_external_scene:=true \
        require_isaac_evidence:=true \
        start_delay_s:=5.0 \
        "$@"
}

internal_expert_wait_runtime() {
    clean_bootstrap required
    require_px4_msgs
    local deadline status echo_status
    deadline=$((SECONDS + 120))
    while ((SECONDS < deadline)); do
        set +e
        status="$(timeout 5s ros2 topic echo \
            /uav/isaac/runtime_status std_msgs/msg/String \
            --once --field data 2>/dev/null)"
        echo_status=$?
        set -e
        if ((echo_status == 0)) \
            && [[ "$status" == *'"fpv_rgb_ready":true'* ]] \
            && [[ "$status" == *'"observer_rgb_ready":true'* ]] \
            && [[ "$status" == *'"fpv_depth_ready":true'* ]]; then
            if ros2 run uav_px4_control px4_sitl_doctor; then
                info "Expert collection Isaac/PX4 runtime ready"
                return 0
            fi
        fi
        sleep 2
    done
    die "expert collection runtime did not become ready within 120 seconds"
}

internal_expert_prepare_scene() {
    local episode_id="$1"
    local random_seed="$2"
    local scene_version="${3:-v4}"
    local scene_profile_path="${4:-}"
    local evidence_path="${5:-}"
    clean_bootstrap required
    require_px4_msgs
    local -a scene_arguments=()
    if [[ -n "$scene_profile_path" ]]; then
        scene_arguments+=(-p "scene_profile_path:=$scene_profile_path")
    fi
    if [[ -n "$evidence_path" ]]; then
        scene_arguments+=(-p "evidence_path:=$evidence_path")
    fi
    ros2 run uav_data_recorder episode_scene_client --ros-args \
        -p episode_id:="$episode_id" \
        -p random_seed:="$random_seed" \
        -p scene_mode:=normal \
        -p scene_version:="$scene_version" \
        -p timeout_s:=20.0 "${scene_arguments[@]}"
}

internal_expert_run_episode() {
    local episode_id="$1"
    local random_seed="$2"
    local dataset_root="$3"
    clean_bootstrap required
    require_px4_msgs
    local sensor_status sensor_status_code
    set +e
    sensor_status="$(timeout 15s ros2 topic echo \
        /uav/isaac/runtime_status std_msgs/msg/String \
        --once --field data 2>/dev/null)"
    sensor_status_code=$?
    set -e
    if ((sensor_status_code != 0)) \
        || [[ "$sensor_status" != *'"fpv_rgb_ready":true'* ]] \
        || [[ "$sensor_status" != *'"observer_rgb_ready":true'* ]] \
        || [[ "$sensor_status" != *'"fpv_depth_ready":true'* ]]; then
        die "expert collection sensor runtime is not ready"
        return 1
    fi

    if [[ "${UAV_EXPERT_SCENE_PREPARED:-0}" != "1" ]]; then
        ros2 run uav_data_recorder episode_scene_client --ros-args \
            -p episode_id:="$episode_id" \
            -p random_seed:="$random_seed" \
            -p scene_mode:=normal \
            -p timeout_s:=20.0
    fi

    local timeout_seconds="${UAV_OFFLINE_TIMEOUT_SECONDS:-180}"
    local timestamp evidence_path episode_evidence launch_status
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    evidence_path="$RUN_LOG_DIR/expert-${episode_id}_${timestamp}.json"
    mkdir -p "$RUN_LOG_DIR"
    warn "AUTHORIZED EXPERT SITL FLIGHT episode=$episode_id seed=$random_seed"
    set +e
    timeout "${timeout_seconds}s" \
        ros2 launch uav_px4_control px4_sitl_flight.launch.py \
        evidence_path:="$evidence_path" \
        timeout_s:="$((timeout_seconds - 10)).0" \
        use_external_scene:=true \
        require_isaac_evidence:=true \
        record_expert_dataset:=true \
        dataset_root:="$dataset_root" \
        episode_id:="$episode_id" \
        collection_mode:=batch \
        random_seed:="$random_seed" \
        expected_runtime_generation:="${UAV_EXPERT_RUNTIME_GENERATION:--1}" \
        expected_scene_revision:="${UAV_EXPERT_SCENE_REVISION:-0}" \
        minimum_fpv_frame_count:="${UAV_EXPERT_MIN_FPV_FRAME:-0}" \
        minimum_observer_frame_count:="${UAV_EXPERT_MIN_OBSERVER_FRAME:-0}" \
        minimum_depth_frame_count:="${UAV_EXPERT_MIN_DEPTH_FRAME:-0}" \
        start_delay_s:=5.0
    launch_status=$?
    set -e
    [[ -f "$evidence_path" ]] || die \
        "episode flight evidence missing (launch status $launch_status)"
    [[ -d "$dataset_root/$episode_id" ]] || die \
        "episode recorder output missing: $dataset_root/$episode_id"
    episode_evidence="$dataset_root/$episode_id/flight_evidence.json"
    cp -- "$evidence_path" "$episode_evidence"
