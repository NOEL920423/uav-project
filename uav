                set +e
                clean_environment_command phase10b-wait-runtime
                runtime_status=$?
                if ((runtime_status == 0)); then
                    clean_environment_command phase10b-expert-episode \
                        "$episode_id" "$seed" "$mode" "$dataset_root"
                    episode_status=$?
                else
                    episode_status=$runtime_status
                fi
                set -e
                stop_managed_process_group "$isaac_pid" "Isaac/PX4"
                stop_managed_process_group "$agent_pid" "XRCE agent"
                if ((runtime_status != 0 || episode_status != 0)); then
                    die "safety-critical managed runtime failure in $episode_id"
                    return 1
                fi
                evidence="$dataset_root/$episode_id/flight_evidence.json"
                python3 -m uav_ml.tools.finalize_expert_episode \
                    --dataset "$dataset_root" \
                    --episode "$episode_id" \
                    --evidence "$evidence" \
                    --expected "$expected"
                python3 -m uav_ml.tools.validate_expert_batch \
                    --dataset "$dataset_root" --episode "$episode_id"
            done
            python3 -m uav_ml.tools.validate_expert_batch \
                --dataset "$dataset_root" --episodes 10
            ;;
