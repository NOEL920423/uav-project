用法：./uav expert-collect-publish --episodes <N> --dataset <name> [--scene v3|v4] [--max-attempts <N>] [--nas-root <path>]

依序收集、驗證並以 SHA-256 驗證後上傳 dataset；僅在上傳完整成功後
刪除 datasets/<name> 的本機資料。dataset 必須是簡短名稱，
例如 cylinder_v3。NAS 路徑優先使用 --nas-root，否則使用 UAV_NAS_ROOT。
EOF
}

command_expert_collect_publish() {
    local episodes="" max_attempts="" dataset=""
    local scene_version="v4"
    local nas_root="${UAV_NAS_ROOT:-}"
    while (($#)); do
        case "$1" in
            --episodes|--max-attempts|--dataset|--nas-root|--scene)
                (($# >= 2)) || die "missing value for $1"
                case "$1" in
                    --episodes) episodes="$2" ;;
                    --max-attempts) max_attempts="$2" ;;
                    --dataset) dataset="$2" ;;
                    --nas-root) nas_root="$2" ;;
                    --scene) scene_version="$2" ;;
                esac
                shift 2
                ;;
            -h|--help)
                expert_collect_publish_usage
                return 0
                ;;
            *)
                die "unknown expert-collect-publish argument: $1"
                return 64
                ;;
        esac
    done
    [[ "$episodes" =~ ^[1-9][0-9]*$ ]] || die "--episodes must be a positive integer"
    [[ "$scene_version" == "v3" || "$scene_version" == "v4" ]] || die "--scene must be v3 or v4"
    [[ -z "$max_attempts" || "$max_attempts" =~ ^[1-9][0-9]*$ ]] || \
        die "--max-attempts must be a positive integer"
    [[ "$dataset" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || \
        die "--dataset must be a simple dataset name"
    [[ -n "$nas_root" && -d "$nas_root" ]] || \
        die "--nas-root must be an existing mounted directory"

    local dataset_root="$REPO_ROOT/datasets/$dataset"
    local -a collect_arguments=(--episodes "$episodes" --dataset "$dataset" --scene "$scene_version")
    if [[ -n "$max_attempts" ]]; then
        collect_arguments+=(--max-attempts "$max_attempts")
    fi
    info "collecting dataset: $dataset_root"
    python3 -m uav_ml.tools.expert_collect "${collect_arguments[@]}"
    info "validating dataset: $dataset_root"
    python3 -m uav_ml.tools.validate_expert_collection \
        --dataset "$dataset_root" --finalize
    info "publishing verified dataset to NAS: $nas_root/datasets/$dataset"
    python3 -m uav_ml.tools.artifact_publish \
        "$dataset_root" --nas-root "$nas_root" --category datasets --delete-local
}

