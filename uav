internal_isaac_trace_replay() {
    local trace_path="$1"
    local playback_speed="$2"
    clean_bootstrap required
    [[ -f "$trace_path" ]] || die "trace file is missing: $trace_path"
    local payload timeout_seconds deadline status
    payload="$(/usr/bin/python3 - "$trace_path" "$playback_speed" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1]).resolve()
speed = float(sys.argv[2])
if speed <= 0.0:
    raise ValueError("playback speed must be positive")
print(json.dumps({"data": json.dumps({
    "command": "replay_trace",
    "trace_path": str(path),
    "playback_speed": speed,
})}))
PY
)" || return 1
    ros2 topic pub --once /uav/isaac/episode_command std_msgs/msg/String \
        "$payload"
    timeout_seconds="$(/usr/bin/python3 - "$trace_path" "$playback_speed" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    samples = json.load(source)["samples"]
duration = float(samples[-1]["time_s"]) / float(sys.argv[2])
print(max(10, int(duration) + 10))
PY
)" || return 1
    deadline=$((SECONDS + timeout_seconds))
    while ((SECONDS < deadline)); do
        status="$(timeout 2s ros2 topic echo /uav/isaac/runtime_status \
            std_msgs/msg/String --once --field data 2>/dev/null || true)"
        if [[ "$status" == *'"state":"completed"'* ]]; then
            return 0
        fi
        if [[ "$status" == *'"episode_command_error"'* ]] \
            && [[ "$status" != *'"episode_command_error":""'* ]]; then
            die "Isaac trace replay failed: $status"
            return 1
        fi
    done
    die "Isaac trace replay timed out after ${timeout_seconds}s"
    return 1
}

process_group_has_live_members() {
    local process_group_id="$1"
    [[ "$process_group_id" =~ ^[1-9][0-9]*$ ]] || return 1
    ps -eo pgid=,stat= | awk -v target="$process_group_id" '
        $1 == target && $2 !~ /^Z/ { found = 1 }
        END { exit(found ? 0 : 1) }
    '
}

stop_managed_process_group() {
    local process_id="$1"
    local label="$2"
    [[ "$process_id" =~ ^[1-9][0-9]*$ ]] || return 0
    if process_group_has_live_members "$process_id"; then
        info "Stopping managed $label process group $process_id"
        kill -INT -- "-$process_id" 2>/dev/null || true
        local attempt
        for ((attempt = 1; attempt <= 20; attempt++)); do
            process_group_has_live_members "$process_id" || break
            sleep 0.5
        done
        if process_group_has_live_members "$process_id"; then
            warn "$label did not exit after SIGINT; sending SIGTERM"
            kill -TERM -- "-$process_id" 2>/dev/null || true
            for ((attempt = 1; attempt <= 20; attempt++)); do
                process_group_has_live_members "$process_id" || break
                sleep 0.5
            done
        fi
        if process_group_has_live_members "$process_id"; then
            warn "$label did not exit after SIGTERM; sending SIGKILL"
            kill -KILL -- "-$process_id" 2>/dev/null || true
        fi
    fi
    wait "$process_id" 2>/dev/null || true
}

expert_scene_preview_usage() {
    cat <<'EOF'
Usage: ./uav expert-scene-preview --seed SEED [--scene v3|v4]

Start the managed expert Isaac/PX4/XRCE runtime, apply one formal episode
scene, and keep WebRTC running until interrupted. No flight, recorder, or
dataset output is started.

Options:
  --seed SEED  Nonnegative deterministic episode scene seed (required)
  --scene      Scene version (default: v4)
  -h, --help   Show this help
EOF
}

command_expert_scene_preview() {
    local random_seed=""
    local scene_version="v4"
    local episode_id="episode_000001"
    while (($# > 0)); do
        case "$1" in
            --seed)
                (($# >= 2)) || die "--seed requires a value"
                random_seed="$2"
                shift 2
                ;;
            --seed=*)
                random_seed="${1#--seed=}"
                shift
                ;;
            --scene)
                (($# >= 2)) || die "--scene requires a value"
                scene_version="$2"
                shift 2
                ;;
            -h|--help)
                expert_scene_preview_usage
                return 0
                ;;
            *)
                die "unknown expert-scene-preview argument: $1"
                return 64
                ;;
        esac
    done
    [[ "$random_seed" =~ ^[0-9]+$ ]] || {
        die "expert-scene-preview requires --seed with a nonnegative integer"
        return 64
    }
    [[ "$scene_version" == "v3" || "$scene_version" == "v4" ]] || die "--scene must be v3 or v4"
    [[ -x "$ISAAC_SIM_RELEASE/isaac-sim.streaming.sh" ]] || die \
        "Isaac streaming launcher missing: $ISAAC_SIM_RELEASE"
    command -v MicroXRCEAgent >/dev/null || die \
        "MicroXRCEAgent is not available"
    if ! /usr/bin/python3 - \
        "$REPO_ROOT/isaac/runtime/bootstrap.py" \
        "$REPO_ROOT/isaac/runtime/environment.py" <<'PY'
import pathlib
import sys

for source_name in sys.argv[1:]:
    source_path = pathlib.Path(source_name)
    try:
        compile(source_path.read_bytes(), str(source_path), "exec")
    except (OSError, SyntaxError) as error:
        print(f"ERROR: invalid Isaac runtime source: {error}", file=sys.stderr)
        raise SystemExit(1)
PY
    then
        die "expert scene preview stopped before launching any process"
        return 1
    fi
    if pgrep -x MicroXRCEAgent >/dev/null \
        || pgrep -f "$ISAAC_SIM_RELEASE/kit/kit" >/dev/null \
        || pgrep -f '/PX4-Autopilot/build/px4_sitl_default/bin/px4' \
            >/dev/null; then
        die "expert scene preview requires no pre-existing Isaac/PX4/XRCE process"
        return 1
    fi

    local preview_timestamp preview_runtime_root
    local preview_agent_pid="" preview_isaac_pid=""
    local runtime_status=1 scene_status=1 isaac_status=0
    local preview_interrupted=0 preview_cleanup_done=0
    preview_timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    preview_runtime_root="$RUN_LOG_DIR/expert-scene-preview_$preview_timestamp"
    mkdir -p "$preview_runtime_root"

    expert_scene_preview_cleanup() {
        ((preview_cleanup_done == 0)) || return 0
        preview_cleanup_done=1
        stop_managed_process_group "$preview_isaac_pid" "preview Isaac/PX4"
        stop_managed_process_group "$preview_agent_pid" "preview XRCE agent"
    }
    trap expert_scene_preview_cleanup EXIT
    trap 'preview_interrupted=1; expert_scene_preview_cleanup' HUP INT TERM

    setsid MicroXRCEAgent udp4 -p 8888 \
        >"$preview_runtime_root/xrce.log" 2>&1 &
    preview_agent_pid=$!
    # shellcheck disable=SC2016
    setsid /usr/bin/bash -c '
        cd -- "$1"
        exec env -u DISPLAY -u WAYLAND_DISPLAY \
            UAV_EXPERT_SENSORS=1 \
            ./isaac-sim.streaming.sh --livestream 2 --exec "$2"
    ' expert-scene-preview-runtime "$ISAAC_SIM_RELEASE" \
        "$REPO_ROOT/isaac/runtime/bootstrap.py" \
        >"$preview_runtime_root/isaac.log" 2>&1 &
    preview_isaac_pid=$!

    info "Starting formal expert scene preview seed=$random_seed"
    info "Runtime logs: $preview_runtime_root"
    set +e
    clean_environment_command expert-runtime-wait
    runtime_status=$?
    if ((runtime_status == 0)); then
        clean_environment_command expert-scene-prepare \
            "$episode_id" "$random_seed" "$scene_version"
        scene_status=$?
    fi
    set -e

    if ((runtime_status == 0 && scene_status == 0)); then
        info "打開 WebRTC 可以看到場景。 episode=$episode_id seed=$random_seed"
        info "不飛行，不收集資料，純檢查場景。 Press Ctrl-C to stop."
        set +e
        wait "$preview_isaac_pid"
        isaac_status=$?
        set -e
    fi

    expert_scene_preview_cleanup
    trap - EXIT HUP INT TERM
    if ((preview_interrupted != 0)); then
        return 130
    fi
    if ((runtime_status != 0)); then
        die "expert scene preview runtime did not become ready"
        return "$runtime_status"
    fi
    if ((scene_status != 0)); then
        die "formal expert scene could not be applied"
        return "$scene_status"
    fi
    if ((isaac_status != 0)); then
        die "preview Isaac runtime exited with status $isaac_status"
        return "$isaac_status"
    fi
}

