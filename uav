    if [[ "$command_name" == "__clean" ]]; then
        if [[ "${UAV_WRAPPER_CLEAN_ENV:-}" != "1" ]]; then
            die "internal clean commands must be entered through a public subcommand"
            return 1
        fi
        shift
        internal_dispatch "$@"
        return
    fi

    case "$command_name" in
        help|-h|--help)
            usage
            ;;
        status)
            require_repository
            command_status
            ;;
        ml-doctor)
            require_repository
            shift
            python3 -m uav_ml.tools.ml_doctor "$@"
            ;;
        rgb-audit)
            require_repository
            shift
            python3 -m uav_ml.tools.rgb_episode_audit "$@"
            ;;
        ae-train)
            require_repository
            shift
            python3 -m uav_ml.train_autoencoder "$@"
            ;;
        isaac-city-smoke)
            require_repository
            shift
            [[ -x "$ISAACLAB_SH" ]] || die "IsaacLab launcher is missing: $ISAACLAB_SH"
            TERM="${TERM:-xterm}" "$ISAACLAB_SH" -p scripts/isaac_city_smoke.py "$@"
            ;;
        isaac-bc-collect)
            require_repository
            shift
            [[ -x "$ISAACLAB_SH" ]] || die "IsaacLab launcher is missing: $ISAACLAB_SH"
            TERM="${TERM:-xterm}" "$ISAACLAB_SH" -p scripts/collect_isaac_bc_demonstrations.py "$@"
            ;;
        latent-prepare)
            require_repository
            shift
            python3 -m uav_ml.tools.prepare_isaac_latents "$@"
            ;;
        latent-bc-train)
            require_repository
            shift
            python3 -m uav_ml.train_latent_bc "$@"
            ;;
        bc-closed-loop)
            require_repository
            shift
            [[ -x "$ISAACLAB_SH" ]] || die "IsaacLab launcher is missing: $ISAACLAB_SH"
            TERM="${TERM:-xterm}" "$ISAACLAB_SH" -p scripts/evaluate_isaac_bc_closed_loop.py "$@"
            ;;
        ppo-train)
            require_repository
            shift
            [[ -x "$ISAACLAB_SH" ]] || die "IsaacLab launcher is missing: $ISAACLAB_SH"
            TERM="${TERM:-xterm}" "$ISAACLAB_SH" -p scripts/train_isaac_bc_initialized_ppo.py "$@"
            ;;
        dataset-generate-synthetic)
            require_repository
            shift
            python3 -m uav_ml.datasets.synthetic_expert "$@"
            ;;
        dataset-check)
            require_repository
            shift
            python3 -m uav_ml.tools.dataset_check "$@"
            ;;
        bc-smoke-test)
            require_repository
            shift
            python3 -m uav_ml.tools.smoke_test "$@"
            ;;
        bc-train)
            require_repository
            shift
            python3 -m uav_ml.train_bc "$@"
            ;;
        ml-test)
            require_repository
            shift
            python3 -m unittest discover -s tests/ml -p 'test_*.py' "$@"
            ;;
        doctor)
            require_repository
            require_ros_base
            command_doctor
            ;;
        build)
            require_repository
            require_ros_base
            shift
            clean_environment_command build "$@"
            ;;
        test)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            clean_environment_command test "$@"
            ;;
        verify)
            require_repository
            require_ros_base
            command_verify
            ;;
        offline)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            clean_environment_command offline "$@"
            ;;
        offline-check)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            command_offline_check "$@"
            ;;
        trajectory-check)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            command_phase4_check \
                trajectory-check \
                'trajectory offline integration passed:' "$@"
            ;;
        pipeline-check)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            command_phase4_check \
                pipeline-check \
                'pipeline offline integration passed:' "$@"
            ;;
        tracking-check)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            command_phase4_check \
                tracking-check \
                'tracking offline integration passed:' "$@"
            ;;
        tracking-safety-check)
            require_repository
            require_ros_base
            require_workspace_overlay
            shift
            local fixture_found=false
            local argument
            for argument in "$@"; do
                if [[ "$argument" == fixture:=* ]]; then
                    fixture_found=true
                fi
            done
            if [[ "$fixture_found" == false ]]; then
                set -- fixture:=stale-odometry "$@"
            fi
            command_phase4_check \
                tracking-safety-check \
                'tracking offline integration passed:' "$@"
            ;;
