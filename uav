                mode="normal"
                expected="any"
                if ((episode_number == 5)); then
                    mode="blocked_goal"
                    expected="failure"
                fi
                info "Phase10B pilot $episode_id/10 seed=$seed mode=$mode"
                setsid MicroXRCEAgent udp4 -p 8888 \
                    >"$runtime_root/${episode_id}_xrce.log" 2>&1 &
                agent_pid=$!
                # shellcheck disable=SC2016
                setsid /usr/bin/bash -c '
                    cd -- "$1"
                    exec env -u DISPLAY -u WAYLAND_DISPLAY \
                        UAV_PHASE10B_SENSORS=1 \
                        ./isaac-sim.streaming.sh --livestream 2 --exec "$2"
                ' phase10b-runtime "$ISAAC_SIM_RELEASE" \
                    "$REPO_ROOT/isaac/runtime/bootstrap.py" \
                    >"$runtime_root/${episode_id}_isaac.log" 2>&1 &
